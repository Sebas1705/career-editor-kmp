<?xml version="1.0" encoding="utf-8"?>
<!--
  Folio launcher foreground icon.
  108×108dp canvas; safe zone is the central 66×66dp (inset 21dp each side).

  Design: bold white "F" lettermark (portfolio/folio) + small teal accent dot.

  F path traced on the 108×108 grid:
    vertical stroke  x 35–49, y 28–80
    top bar          x 35–73, y 28–40
    middle bar       x 35–63, y 50–62
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White "F" lettermark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M35,28
          L73,28 L73,40 L49,40
          L49,50 L63,50 L63,62 L49,62
          L49,80 L35,80
          Z" />

    <!-- Teal accent dot — bottom-right of safe zone -->
    <path
        android:fillColor="#00B8A9"
        android:pathData="M76,76 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />

</vector>
